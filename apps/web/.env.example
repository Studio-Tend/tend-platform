# Resend: API key with "Sending access", restricted to your sending domain
RESEND_API_KEY=
# Must use a domain verified in Resend. Before verification, use: Tend <onboarding@resend.dev>
EMAIL_FROM="Tend <weekly-planner@mail.heytend.co>"
# Optional: where replies go (an inbox you read)
EMAIL_REPLY_TO=
# Public site origin used to build the "reopen this week" link in the email.
# The client never sends this URL.
SITE_URL=https://www.heytend.co
# Upstash Redis, used to rate limit POST /api/send-week (per IP, and per
# recipient per day). Required in production: without it the route refuses to
# send rather than run as an open relay for our sending domain. Leave blank
# locally and limiting is skipped.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional. Set to `staging` on the staging deploy so its keys
# (`staging:send-week:ip:…`) stay distinct in a shared Upstash database.
# Leave unset in production; existing keys stay unprefixed.
REDIS_KEY_PREFIX=
# PostHog: project API key from Project settings. HOST is the region ingest
# URL for the Node SDK (us.i.posthog.com or eu.i.posthog.com). The browser
# SDK sends through same-origin /ingest rewrites, not this host. Capture is
# off in next dev, and on Vercel preview/staging deploys (VERCEL_ENV other
# than `production`), so only real use reaches the live project. Vercel sets
# VERCEL_ENV / NEXT_PUBLIC_VERCEL_ENV itself; nothing to add here.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
