{
  "name": "tend",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "mobile": "pnpm --filter @tend/mobile start",
    "api": "pnpm --filter @tend/api start:dev",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm --filter @tend/core build && pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
